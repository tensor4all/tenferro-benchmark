+                DType::I32 => binary!(i32, mul_int),
+                DType::I64 => binary!(i64, mul_int),
+                DType::C32 => binary!(Complex32, mul_complex),
+                DType::C64 => binary!(Complex64, mul_complex),
+                _ => return None,
+            },
+            ElementwiseReadOp::Negate => match dtype {
