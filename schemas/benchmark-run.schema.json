{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensor4all.example/schemas/benchmark-run.schema.json",
  "title": "Benchmark Run Metadata",
  "type": "object",
  "required": [
    "schema_version",
    "target_profile",
    "suite_id",
    "suite_file",
    "timestamp",
    "tenferro_rs",
    "environment"
  ],
  "additionalProperties": false,
  "properties": {
    "timing_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "scope",
        "setup",
        "cleanup",
        "minimum_untimed_priming_runs",
        "setup_diagnostics"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "scope": {
          "type": "string"
        },
        "setup": {
          "type": "string"
        },
        "cleanup": {
          "type": "string"
        },
        "minimum_untimed_priming_runs": {
          "type": "integer",
          "minimum": 1
        },
        "short_operation_sampling": { "type": "string" },
        "trace_execution": { "type": "string" },
        "setup_diagnostics": {
          "type": "boolean"
        }
      }
    },
    "schema_version": { "const": 1 },
    "target_profile": {
      "enum": ["mac-cpu", "mac-gpu", "amd-cpu", "zen5-cpu", "zen2-cpu", "nvidia-gpu"]
    },
    "suite_id": {
      "type": "string",
      "pattern": "^(cpu|gpu)/[a-z0-9][a-z0-9_.-]*$"
    },
    "suite_file": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time", "minLength": 1 },
    "tenferro_rs": { "$ref": "#/$defs/tenferro_rs" },
    "harness": {
      "type": "object",
      "required": ["commit", "dirty"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "commit": { "type": "string", "minLength": 1 },
        "dirty": { "type": ["boolean", "null"] }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "command": { "type": "string" },
        "coverage": { "enum": ["quick", "full"] },
        "effort": { "enum": ["scan", "standard", "confirm", "aa"] },
        "manifest_version": { "type": "integer" },
        "selection_filter": { "type": ["string", "null"] },
        "expected_cases": { "type": "integer" },
        "selected_cases": { "type": "integer" }
      }
    },
    "environment": { "$ref": "#/$defs/environment" },
    "host": { "$ref": "#/$defs/host" },
    "build": { "$ref": "#/$defs/build" },
    "blas": { "$ref": "#/$defs/blas" },
    "resolved_deps": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "python_backends": { "$ref": "#/$defs/python_backends" },
    "julia": { "$ref": "#/$defs/julia_backend" },
    "cuda": { "$ref": "#/$defs/cuda" },
    "metal": { "$ref": "#/$defs/metal" }
  },
  "$defs": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "description": "The `campaign_toolkit.hostinfo` record: the power, NUMA, SMT and L3 facts that decide whether two measurements are comparable. Optional, and fields the host does not expose are null, so the block is recorded wherever the module can run.",
      "properties": {
        "cpu": { "type": ["string", "null"] },
        "logical_cpus": { "type": ["integer", "null"], "minimum": 1 },
        "power": {
          "type": ["object", "null"],
          "description": "Power/frequency controls in force while measuring, read from sysfs when the host exposes them.",
          "additionalProperties": false,
          "properties": {
            "cpufreq_boost": { "type": "string" },
            "intel_no_turbo": { "type": "string" },
            "amd_pstate_status": { "type": "string" },
            "platform_profile": { "type": "string" },
            "governor": { "type": "string" },
            "energy_performance_preference": { "type": "string" },
            "scaling_max_freq_khz": { "type": "string" },
            "smt": {
              "type": "object",
              "description": "Simultaneous multithreading as the kernel reports it, raw strings: `active` is 1 or 0, `control` is on, off, forceoff or notsupported.",
              "additionalProperties": false,
              "properties": {
                "active": { "type": "string" },
                "control": { "type": "string" }
              }
            }
          }
        },
        "numa": {
          "type": ["object", "null"],
          "description": "The NUMA layout the host exposed: the node count, which on a Zen 2 host is the NPS setting, and each node's CPU list.",
          "additionalProperties": false,
          "required": ["nodes"],
          "properties": {
            "nodes": { "type": "integer", "minimum": 1 },
            "cpulists": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "smt_siblings": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "l3_domains": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "description": "How the measured binary was built, as far as the recorder can state it. Optional: manifests recorded before this block existed do not have it.",
      "properties": {
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "description": "The compiler and flags in the recorder's environment, which the build inherits; flags set only in a cargo config file are not visible here. `rustc` is the verbatim `rustc -vV`.",
          "properties": {
            "rustc": { "type": ["string", "null"] },
            "rustc_release": { "type": ["string", "null"] },
            "rustflags": { "type": ["string", "null"] },
            "target_cpu": {
              "type": ["string", "null"],
              "description": "The `-C target-cpu` named by the flags, null when they name none."
            }
          }
        }
      }
    },
    "tenferro_rs": {
      "type": "object",
      "required": ["path", "commit", "dirty", "features"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$"
        },
        "resolved_path": { "type": "string" },
        "dirty": { "type": ["boolean", "null"] },
        "features": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostname": { "type": ["string", "null"] },
        "os": { "type": ["string", "null"] },
        "arch": { "type": ["string", "null"] },
        "cpu": { "type": ["string", "null"] },
        "affinity": { "$ref": "#/$defs/affinity" },
        "env": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        }
      }
    },
    "affinity": {
      "type": "object",
      "description": "CPU placement of the measured process (pinned profiles run each thread row under taskset).",
      "additionalProperties": false,
      "properties": {
        "pinning": { "enum": ["none", "taskset"] },
        "requested_measured_cpus": { "type": ["string", "null"] },
        "observer_cpus": { "type": ["string", "null"] },
        "override_of": { "type": ["string", "null"] },
        "thread_budget": { "type": ["string", "null"] },
        "measured_cpus": { "type": ["string", "null"] },
        "l3_domains": { "type": ["array", "null"], "items": { "type": "string" } },
        "cpu_boost": { "type": ["string", "null"] },
        "scaling_governor": { "type": ["string", "null"] },
        "scaling_driver": { "type": ["string", "null"] }
      }
    },
    "blas": {
      "oneOf": [
        {
          "type": "object",
          "required": ["implementation", "version", "root", "library"],
          "additionalProperties": false,
          "properties": {
            "implementation": { "const": "openblas" },
            "version": { "type": "string", "minLength": 1 },
            "root": { "type": "string", "minLength": 1 },
            "library": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["implementation"],
          "additionalProperties": false,
          "properties": {
            "implementation": { "const": "none" }
          }
        },
        {
          "type": "object",
          "required": ["implementation", "version", "root", "library"],
          "additionalProperties": false,
          "properties": {
            "implementation": { "const": "mkl" },
            "version": { "type": "string", "minLength": 1 },
            "root": { "type": "string", "minLength": 1 },
            "library": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["implementation", "version", "library"],
          "additionalProperties": false,
          "properties": {
            "implementation": { "const": "accelerate" },
            "version": { "type": "string", "minLength": 1 },
            "library": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "python_backends": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pytorch": { "$ref": "#/$defs/python_backend" },
        "jax": { "$ref": "#/$defs/python_backend" }
      }
    },
    "python_backend": {
      "type": "object",
      "required": ["available"],
      "additionalProperties": false,
      "properties": {
        "available": { "type": "boolean" },
        "version": { "type": ["string", "null"], "minLength": 1 },
        "jaxlib_version": { "type": ["string", "null"], "minLength": 1 },
        "backend": { "type": ["string", "null"], "minLength": 1 },
        "file": { "type": ["string", "null"], "minLength": 1 },
        "provider": { "$ref": "#/$defs/provider_name" },
        "dot_backend": { "$ref": "#/$defs/xla_backend_name" },
        "lapack_provider": { "$ref": "#/$defs/provider_name" },
        "config": { "type": "string", "minLength": 1 },
        "blas_info": { "type": ["string", "null"], "minLength": 1 },
        "lapack_info": { "type": ["string", "null"], "minLength": 1 },
        "library": { "type": ["string", "null"], "minLength": 1 },
        "linked_libraries": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "julia_backend": {
      "type": "object",
      "required": ["available"],
      "additionalProperties": false,
      "properties": {
        "available": { "type": "boolean" },
        "version": { "type": ["string", "null"], "minLength": 1 },
        "strided_version": { "type": ["string", "null"], "minLength": 1 },
        "omeinsum_version": { "type": ["string", "null"], "minLength": 1 },
        "blas_provider": { "type": ["string", "null"], "minLength": 1 },
        "threads": { "type": ["integer", "null"], "minimum": 0 },
        "reason": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "provider_name": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["openblas", "accelerate", "mkl", "internal_lapack", "blas_lapack", "none_detected"]
        },
        {
          "type": "string",
          "pattern": "^xla_[a-z0-9_]+$"
        },
        { "type": "null" }
      ]
    },
    "xla_backend_name": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^xla_[a-z0-9_]+$"
        },
        { "type": "null" }
      ]
    },
    "metal": {
      "type": "object",
      "required": ["device_name", "runtime"],
      "additionalProperties": true,
      "properties": {
        "device_name": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "os_version": { "type": ["string", "null"] },
        "metal_version": { "type": ["string", "null"] }
      }
    },
    "cuda": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device_ordinal": { "type": ["integer", "null"], "minimum": 0 },
        "device_name": { "type": ["string", "null"] },
        "device_uuid": { "type": ["string", "null"] },
        "device_memory_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "driver_version": { "type": ["string", "null"] },
        "runtime_version": { "type": ["string", "null"] },
        "cuda_version": { "type": ["string", "null"] },
        "cudnn_version": { "type": ["string", "null"] }
      }
    }
  }
}
