{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensor4all.example/schemas/small-work-result.schema.json",
  "title": "CPU small-work benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "case_id",
    "contract_id",
    "family",
    "surface",
    "operation",
    "phase",
    "api_tier",
    "backend",
    "provider",
    "dtype",
    "layout",
    "shape",
    "workflow",
    "calls_per_workflow",
    "setup",
    "scope",
    "samples",
    "timing",
    "correctness",
    "timing_validity",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "suite_id": {
      "const": "cpu/small_work"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "setup",
        "execution",
        "validation"
      ]
    },
    "api_tier": {
      "enum": [
        "concrete-fresh",
        "concrete-shared",
        "borrowed-fresh",
        "borrowed-shared",
        "eager-no-ad",
        "eager-ad",
        "prepared-setup",
        "prepared-repeat",
        "compiled-repeat"
      ]
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "dtype": {
      "type": "string",
      "minLength": 1
    },
    "layout": {
      "type": "string",
      "minLength": 1
    },
    "shape": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "calls_per_workflow": {
      "type": "integer",
      "minimum": 1
    },
    "setup": {
      "$ref": "#/$defs/setup"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "samples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sample"
      }
    },
    "timing": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/timing"
        }
      ]
    },
    "correctness": {
      "$ref": "#/$defs/correctness"
    },
    "timing_validity": {
      "$ref": "#/$defs/validity"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includes",
        "excludes"
      ],
      "properties": {
        "includes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timer",
        "outside_timer"
      ],
      "properties": {
        "timer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outside_timer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_index",
        "sample_index",
        "elapsed_ns",
        "iterations"
      ],
      "properties": {
        "process_index": {
          "type": "integer",
          "minimum": 0
        },
        "sample_index": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ns": {
          "type": "integer",
          "minimum": 1
        },
        "iterations": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "process_count",
        "raw_elapsed_ns",
        "median_ns",
        "iqr_ns",
        "raw_aggregate_median_ns",
        "raw_aggregate_iqr_ns",
        "process_median_ns",
        "process_median_iqr_ns",
        "process_median_dispersion_ns",
        "process_median_cov",
        "normalized_ns_per_call",
        "normalized_ns_per_workflow"
      ],
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "process_count": {
          "type": "integer",
          "minimum": 1
        },
        "raw_elapsed_ns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "median_ns": {
          "type": "integer",
          "minimum": 1
        },
        "iqr_ns": {
          "type": "integer",
          "minimum": 0
        },
        "raw_aggregate_median_ns": {
          "type": "integer",
          "minimum": 1
        },
        "raw_aggregate_iqr_ns": {
          "type": "integer",
          "minimum": 0
        },
        "process_median_ns": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "process_median_iqr_ns": {
          "type": "number",
          "minimum": 0
        },
        "process_median_dispersion_ns": {
          "type": "number",
          "minimum": 0
        },
        "process_median_cov": {
          "type": "number",
          "minimum": 0
        },
        "normalized_ns_per_call": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "normalized_ns_per_workflow": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "valid",
            "inconclusive",
            "invalid"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
