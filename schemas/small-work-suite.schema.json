{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensor4all.example/schemas/small-work-suite.schema.json",
  "title": "CPU small-work suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "title",
    "description",
    "contract_version",
    "protocol",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "suite_id": {
      "const": "cpu/small_work"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "const": 2
    },
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmups",
        "runs",
        "independent_processes",
        "samples_per_process",
        "calibration",
        "noise_policy",
        "resource_policy"
      ],
      "properties": {
        "warmups": {
          "type": "integer",
          "minimum": 0
        },
        "runs": {
          "type": "integer",
          "minimum": 1
        },
        "independent_processes": {
          "type": "integer",
          "minimum": 2
        },
        "samples_per_process": {
          "type": "integer",
          "minimum": 2
        },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "target_ns"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "target_ns": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "noise_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "process_median_cov_max"
          ],
          "properties": {
            "process_median_cov_max": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "resource_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "busy_threshold",
            "requested_threads"
          ],
          "properties": {
            "busy_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "requested_threads": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contract_id",
        "family",
        "surface",
        "operation",
        "phase",
        "api_tier",
        "backend",
        "dtype",
        "layout",
        "shape",
        "calls_per_workflow",
        "workflow",
        "setup",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "setup",
            "execution",
            "validation"
          ]
        },
        "api_tier": {
          "enum": [
            "concrete-fresh",
            "concrete-shared",
            "borrowed-fresh",
            "borrowed-shared",
            "eager-no-ad",
            "eager-ad",
            "prepared-setup",
            "prepared-repeat",
            "compiled-repeat"
          ]
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "calls_per_workflow": {
          "type": "integer",
          "minimum": 1
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "setup": {
          "$ref": "#/$defs/setup"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includes",
        "excludes"
      ],
      "properties": {
        "includes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timer",
        "outside_timer"
      ],
      "properties": {
        "timer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outside_timer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
